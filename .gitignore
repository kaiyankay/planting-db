# OS / editor
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Secrets — never commit
.env
.env.*
!.env.example

# Raw survey exports (T4 input) carry respondent emails; only the README is tracked
inputs/survey/*
!inputs/survey/README.md

# Local scratch
*.log

# Scale-test roots (synthetic plants) — regenerated by tools/scale_test.py
tests/scale/out/

# T4 private map (pseudonym -> survey response id) — never tracked
inputs/survey/respondent_map.json
inputs/survey/plant_candidates-derived-*.json

# T1 scratch output before --merge
*.cov_claims.json

# Verification workbench — PRIVATE (reviewer identifiers, reasons) and licence-restricted page copies
review/events/*.jsonl
review/ai/cache/
tests/review/out/
