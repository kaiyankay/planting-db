{
  "$schema_version": "0.3.0",
  "name": "Planting Intelligence — Local Planting Knowledge Database",
  "scope": "City of Vancouver / Metro Vancouver, BC (Canadian hardiness zone 8a–8b)",
  "updated": "2026-10-30",
  "design_basis": {
    "field_tiers": "ARCH 540 user survey c1 (must-pass vs compared) and c2 (could not find / did not trust), n=6, 2026-10-30",
    "practitioner_metadata": "survey f1 (details needed before trusting someone's note)",
    "source_priority": "survey f2 (what makes an AI suggestion credible)",
    "conflict_rule": "survey c3 (what people do when sources disagree)",
    "controlled_vocabularies": "KPU Plant Database search facets (plantdatabase.kpu.ca)"
  },
  "entity": {
    "description": "One record per plant. Identity only — no attribute values here; attributes live in claims.",
    "fields": {
      "id": {
        "type": "string",
        "note": "slug of accepted scientific name, e.g. acer-palmatum"
      },
      "scientific_name": {
        "type": "string",
        "required": true
      },
      "synonyms_scientific": {
        "type": "string[]"
      },
      "common_names": {
        "type": "object",
        "shape": {
          "en": "string[]",
          "zh": "string[]"
        }
      },
      "family": {
        "type": "string"
      },
      "kpu_plant_type": {
        "type": "enum",
        "vocab": "kpu_plant_type"
      },
      "respondent_roles": {
        "type": "string[]",
        "note": "roles as typed by survey respondents, kept raw; never overwrites kpu_plant_type"
      },
      "origin_status": {
        "type": "enum",
        "values": [
          "native_bc_west_of_cascades",
          "native_north_america",
          "non_native",
          "invasive_bc"
        ],
        "note": "origin fact is entity-level; invasive *risk assessment* is a gate claim"
      },
      "external_refs": {
        "type": "object",
        "shape": {
          "kpu": "url",
          "mobot": "url",
          "gpp": "url",
          "eflora": "url",
          "osu": "url",
          "rhs": "url",
          "usda": "url",
          "inat": "url"
        },
        "note": "links to the source page for this plant; kpu is link-only (never imported)"
      },
      "in_vancouver_street_tree_list": {
        "type": "boolean|null"
      }
    }
  },
  "field_tiers": {
    "gate": {
      "description": "Filter first. Survey c1: ≥3 of 5 respondents marked these must-pass. A plant failing a gate is excluded before ranking.",
      "fields": {
        "hardiness_zone": {
          "type": "enum",
          "vocab": "kpu_hardiness",
          "value_kinds": [
            "categorical",
            "quantitative"
          ],
          "survey": "c1 must_pass 4/5",
          "fill_from": [
            "kpu",
            "gpp",
            "mobot"
          ]
        },
        "invasive_status": {
          "type": "enum",
          "value_kinds": [
            "categorical"
          ],
          "values": [
            "not_listed",
            "watch",
            "regulated_bc",
            "prohibited_bc"
          ],
          "survey": "c1 must_pass 4/5",
          "fill_from": [
            "iscbc",
            "kpu"
          ]
        },
        "water_drainage": {
          "type": "enum",
          "value_kinds": [
            "categorical"
          ],
          "values": [
            "dry",
            "average",
            "moist",
            "wet",
            "wide_range"
          ],
          "survey": "c1 must_pass 3/5",
          "fill_from": [
            "kpu",
            "gpp",
            "mobot",
            "growgreen"
          ]
        },
        "mature_height": {
          "type": "enum|range",
          "vocab": "kpu_height_bins",
          "value_kinds": [
            "categorical",
            "quantitative"
          ],
          "unit": "m",
          "survey": "c1 must_pass 3/5; c2 'real mature size under local conditions' 3/6",
          "fill_from": [
            "kpu",
            "gpp",
            "mobot",
            "osu"
          ]
        },
        "mature_spread": {
          "type": "enum|range",
          "vocab": "kpu_spread_bins",
          "value_kinds": [
            "categorical",
            "quantitative"
          ],
          "unit": "m",
          "survey": "c1 must_pass 3/5",
          "fill_from": [
            "kpu",
            "gpp",
            "mobot",
            "osu"
          ]
        },
        "maintenance_level": {
          "type": "enum",
          "value_kinds": [
            "categorical"
          ],
          "values": [
            "low",
            "medium",
            "high"
          ],
          "survey": "c1 must_pass 3/5; e1/e2 'low maintenance' is a top intent word",
          "fill_from": [
            "gpp",
            "growgreen",
            "practitioner"
          ]
        },
        "ecological_value": {
          "type": "enum[]",
          "value_kinds": [
            "categorical"
          ],
          "values": [
            "native",
            "pollinator",
            "bird_food",
            "wildlife_cover",
            "nitrogen_fixer",
            "erosion_control",
            "habitat_structure"
          ],
          "survey": "c1 must_pass 3/5; e1 'pollinator friendly', 'high ecological function'",
          "fill_from": [
            "eflora",
            "pojar",
            "growgreen",
            "practitioner"
          ]
        }
      }
    },
    "compare": {
      "description": "Rank after gating. Survey c1: mostly 'compared', not must-pass.",
      "fields": {
        "exposure": {
          "type": "enum[]",
          "vocab": "kpu_exposure",
          "value_kinds": [
            "categorical"
          ],
          "survey": "c1 compared 3/5"
        },
        "seasonal_interest": {
          "type": "object",
          "value_kinds": [
            "categorical",
            "quantitative",
            "qualitative"
          ],
          "shape": {
            "flowering_months": "int[]",
            "flower_colour": "kpu_colour[]",
            "foliage_colour": "kpu_colour[]|string",
            "fall_colour": "bool|string",
            "fruit": "string",
            "winter_interest": "bool|string",
            "evergreen": "bool"
          },
          "shape_note": "foliage_colour = leaf colour through the growing season (e.g. red-purple cultivars); fall_colour = autumn change only",
          "survey": "c1 must_pass 2 / compared 2; d1 'seasonal interest', 'fall color' are the most common selection reasons"
        },
        "texture": {
          "type": "enum",
          "vocab": "kpu_texture",
          "value_kinds": [
            "categorical"
          ]
        },
        "form": {
          "type": "enum",
          "vocab": "kpu_form",
          "value_kinds": [
            "categorical"
          ]
        },
        "habit": {
          "type": "enum",
          "vocab": "kpu_habit",
          "value_kinds": [
            "categorical"
          ]
        },
        "soil_type": {
          "type": "enum[]",
          "vocab": "kpu_soil",
          "value_kinds": [
            "categorical"
          ]
        },
        "growth_rate": {
          "type": "enum",
          "value_kinds": [
            "categorical"
          ],
          "values": [
            "slow",
            "moderate",
            "fast"
          ]
        },
        "landscape_use": {
          "type": "enum[]",
          "vocab": "kpu_landscape_use",
          "value_kinds": [
            "categorical"
          ]
        },
        "pest_susceptibility": {
          "type": "enum[]",
          "vocab": "kpu_pest",
          "value_kinds": [
            "categorical"
          ],
          "note": "susceptibilities only (schema 0.3.0, D7). KPU pseudo-values like (Drought tolerant) are NOT stored here — they map to resistances"
        },
        "resistances": {
          "type": "enum[]",
          "vocab": "resistances",
          "value_kinds": [
            "categorical"
          ],
          "note": "positive tolerances and resistances a source states (leaf scorch, drought, deer…). Added 0.3.0 so a resistance is never recorded as a negated susceptibility",
          "fill_from": [
            "gpp",
            "mobot",
            "kpu",
            "practitioner"
          ]
        }
      }
    },
    "extended": {
      "description": "What existing databases lack. Survey c2/c4. Mostly free text with optional structured value; practitioner sources expected to dominate here.",
      "fields": {
        "time_to_intended_size": {
          "type": "text|range",
          "unit": "years",
          "value_kinds": [
            "quantitative",
            "qualitative"
          ],
          "survey": "c1: 0/5 must_pass, 3/5 not_considered — but c2 'real mature size' 3/6 could not find. Not in workflow because no data exists."
        },
        "local_mature_size": {
          "type": "text|range",
          "unit": "m",
          "value_kinds": [
            "quantitative",
            "qualitative"
          ],
          "survey": "c2 3/6",
          "note": "size actually observed in Vancouver conditions, distinct from literature mature_height"
        },
        "long_term_performance": {
          "type": "text",
          "value_kinds": [
            "qualitative"
          ],
          "survey": "c2 2/6"
        },
        "appearance_by_age_season": {
          "type": "text",
          "value_kinds": [
            "qualitative"
          ],
          "survey": "c2 1/6"
        },
        "behaviour_with_others": {
          "type": "text",
          "value_kinds": [
            "qualitative"
          ],
          "survey": "c2 3/6",
          "note": "summary pointer; detailed pairwise facts live in relations.json"
        },
        "toxicity": {
          "type": "object",
          "value_kinds": [
            "categorical",
            "qualitative"
          ],
          "shape": {
            "pets": "enum[none, mild, moderate, severe, unknown]",
            "humans": "enum",
            "parts": "string",
            "usda_rating": "enum[none, slight, moderate, severe]"
          },
          "survey": "c4 'toxic to pets' — explicitly asked, could not find",
          "fill_from": [
            "aspca"
          ],
          "shape_note": "usda_rating = USDA PLANTS 'Toxicity' characteristic (livestock/conservation rating), added 2026-10-30 (M17); pets / humans are separate judgements and stay unknown unless a source addresses them"
        },
        "photoperiod": {
          "type": "enum",
          "value_kinds": [
            "categorical"
          ],
          "values": [
            "long_day",
            "short_day",
            "day_neutral",
            "unknown"
          ],
          "survey": "c4"
        },
        "local_availability": {
          "type": "object",
          "value_kinds": [
            "qualitative"
          ],
          "shape": {
            "nurseries": "string[]",
            "sizes": "string[]",
            "approx_cost": "string"
          },
          "survey": "c2 3/6",
          "fill_from": [
            "nats"
          ],
          "note": "not a prototype priority; keep the slot"
        },
        "vancouver_context": {
          "type": "text",
          "value_kinds": [
            "qualitative",
            "quantitative"
          ],
          "note": "any claim whose context is explicitly Vancouver / Lower Mainland (clay soils, winter wet, summer drought, street tree record)"
        },
        "in_vancouver_street_tree_list": {
          "type": "boolean",
          "value_kinds": [
            "categorical"
          ],
          "fill_from": [
            "cov_trees"
          ],
          "note": "claim-level evidence (count, snapshot date) behind the entity flag of the same name; merge_claims copies a verified claim's value onto the entity"
        }
      }
    },
    "custom": {
      "description": "User-extensible. Open key–value tags, not validated against schema. Analogous to KPU's 'Plants by Course' slicing.",
      "shape": {
        "key": "string",
        "value": "string",
        "added_by": "string",
        "added_at": "date"
      }
    }
  },
  "claim": {
    "description": "The atomic unit of knowledge AND the retrieval unit. Every attribute value is a claim. A field may hold many claims; they are never merged or averaged.",
    "required": [
      "id",
      "plant",
      "field",
      "value",
      "value_kind",
      "text",
      "source_id",
      "source_type",
      "context",
      "confidence",
      "recorded_at"
    ],
    "fields": {
      "id": {
        "type": "string",
        "format": "<plant-id>:<field>:<nn>"
      },
      "plant": {
        "type": "string",
        "ref": "entity.id"
      },
      "field": {
        "type": "string",
        "ref": "field_tiers.*.fields"
      },
      "value": {
        "type": "any",
        "note": "typed per field definition; ranges as {min, max, unit}"
      },
      "value_kind": {
        "type": "enum",
        "values": [
          "quantitative",
          "categorical",
          "qualitative"
        ],
        "note": "how the value is matched at retrieval. quantitative = numbers / ranges / counts ({min,max,unit} or {n, median, ...}): range filter + numeric display. categorical = enum values from vocab, or booleans: exact match. qualitative = free text or loosely structured notes: semantic match only. Must be one of the field's value_kinds.",
        "derivation": "qualitative -> categorical is allowed when the new claim carries derived_from pointing at the qualitative claim (same source). categorical -> qualitative is not: a controlled value must not be paraphrased into prose and re-stored as new evidence."
      },
      "text": {
        "type": "string",
        "note": "one natural-language sentence; embedding is built on this. Auto-generated from value+source+context, or the practitioner's own words verbatim."
      },
      "source_id": {
        "type": "string",
        "ref": "sources.json"
      },
      "source_type": {
        "type": "enum",
        "values": [
          "practitioner",
          "database",
          "literature",
          "municipal",
          "model"
        ],
        "priority_order": [
          "practitioner",
          "database",
          "literature",
          "municipal",
          "model"
        ],
        "basis": "survey f2: first-hand experience 4/6 > shows sources 3/6 > local project 2/6 > explains reasoning 1/6"
      },
      "context": {
        "type": "string",
        "examples": [
          "general",
          "PNW",
          "Vancouver clay soil",
          "container, rooftop",
          "cultivar: 'Bloodgood'"
        ]
      },
      "confidence": {
        "type": "number",
        "range": [
          0,
          1
        ],
        "caps": {
          "model": 0.5
        }
      },
      "status": {
        "type": "enum",
        "values": [
          "verified",
          "unverified",
          "disputed",
          "retired"
        ],
        "default": "unverified"
      },
      "recorded_at": {
        "type": "date"
      },
      "recorded_by": {
        "type": "string"
      },
      "claim_kind": {
        "type": "enum",
        "values": [
          "attribute",
          "selection_reason",
          "observation",
          "warning"
        ],
        "note": "selection_reason = survey d1 'why'; observation/warning = survey d2 notes"
      },
      "practitioner_meta": {
        "type": "object",
        "ref": "practitioner_meta",
        "required_if": "source_type == practitioner"
      },
      "derived_from": {
        "type": "string",
        "ref": "claim.id",
        "note": "claim this one was read off, same source; see value_kind.derivation"
      },
      "verify_against": {
        "type": "string[]",
        "ref": "sources.json",
        "note": "model claims only: sources expected to replace this placeholder"
      },
      "retired_by": {
        "type": "string",
        "ref": "claim.id",
        "note": "set by merge_claims when a verified non-model claim lands on a field that only had model placeholders"
      }
    }
  },
  "practitioner_meta": {
    "description": "Metadata a first-hand note must carry. Field list is survey f1 verbatim.",
    "fields": {
      "basis": {
        "type": "enum",
        "values": [
          "read",
          "observed",
          "project"
        ],
        "survey": "d2 basis field",
        "required": true
      },
      "location": {
        "type": "string",
        "survey": "f1 3/6"
      },
      "maintenance_received": {
        "type": "string",
        "survey": "f1 3/6"
      },
      "observer_background": {
        "type": "string",
        "survey": "f1 'who wrote it and their experience' 3/6",
        "note": "copied from sources.json practitioner record: roles + experience, anonymous"
      },
      "site_conditions": {
        "type": "string",
        "survey": "f1 2/6"
      },
      "season_observed": {
        "type": "string",
        "survey": "f1 2/6"
      },
      "plant_age_years": {
        "type": "number",
        "survey": "f1 1/6"
      }
    },
    "completeness_levels": {
      "L0": {
        "has": [],
        "citable": false,
        "note": "no basis — store only"
      },
      "L1": {
        "has": [
          "basis"
        ],
        "citable": true,
        "caveat": "location not recorded"
      },
      "L2": {
        "has": [
          "basis",
          "location"
        ],
        "citable": true
      },
      "L3": {
        "has": [
          "basis",
          "location",
          "+2 of site_conditions/maintenance_received/season_observed/plant_age_years"
        ],
        "citable": true,
        "rank_boost": 0.1
      }
    }
  },
  "relation": {
    "description": "Pairwise facts between plants. Stored in relations.json, not inside either plant.",
    "fields": {
      "id": "string",
      "plant_a": "entity.id",
      "plant_b": "entity.id",
      "relation_type": {
        "type": "enum",
        "values": [
          "companion",
          "co_listed",
          "competes",
          "shades",
          "suppresses",
          "supports_habitat",
          "layered_under",
          "avoid_with"
        ]
      },
      "direction": {
        "type": "enum",
        "values": [
          "a_to_b",
          "b_to_a",
          "mutual"
        ]
      },
      "text": "string",
      "source_id": "string",
      "source_type": "enum",
      "context": "string",
      "confidence": "number",
      "status": "enum",
      "recorded_at": "date",
      "practitioner_meta": "object (if practitioner)"
    }
  },
  "rules": [
    {
      "id": "R1",
      "rule": "A field may hold multiple claims. Never merge, average or pick a 'safe' value. Return all, with context.",
      "basis": "survey c3: trusted-source / local-example / keep-both each 2/6; cautious 0/6; authoritative 0/6"
    },
    {
      "id": "R2",
      "rule": "A practitioner claim without `basis` is L0: stored, never cited. L1 may be cited with the caveat 'location not recorded'.",
      "basis": "survey f1"
    },
    {
      "id": "R3",
      "rule": "No claim without a source_id. Values inferred by the model carry source_type=model, confidence ≤ 0.5, status=unverified.",
      "basis": "survey f2: 'shows its sources' 3/6"
    },
    {
      "id": "R4",
      "rule": "Every claim has a `text` rendering. Practitioner notes keep the original wording.",
      "basis": "retrieval: embeddings are built on text, not on structured values"
    },
    {
      "id": "R5",
      "rule": "Ranking of retrieved claims: source_type priority → geographic specificity of source (Vancouver > BC > PNW > global) → completeness level → confidence. Vector similarity decides recall, not order.",
      "basis": "survey f2 + f1"
    },
    {
      "id": "R6",
      "rule": "When answering, attribute to the person or source, not to the reasoning: 'a designer with professional project experience observed…' rather than 'because it is an understory plant, I infer…'.",
      "basis": "survey f2: first-hand 4/6 vs reasoning 1/6"
    },
    {
      "id": "R7",
      "rule": "Gate fields are hard filters applied before semantic retrieval; compare and extended fields are ranked semantically.",
      "basis": "survey c1"
    },
    {
      "id": "R8",
      "rule": "Respondent-typed roles and names are kept raw in respondent_roles / raw_names; normalisation goes in synonyms.json and kpu_plant_type.",
      "basis": "survey d1 role mismatches (fern typed as shrub; forbs typed as perennial_grass)"
    },
    {
      "id": "R9",
      "rule": "Every claim declares value_kind. A qualitative claim may be read into a categorical one (with derived_from); a categorical claim is never expanded back into a qualitative one.",
      "basis": "retrieval routes (principles §6): structured filter needs exact values, semantic search needs text; the direction keeps provenance one-way"
    },
    {
      "id": "R10",
      "rule": "Model placeholders are retired, not deleted, as soon as any claim with source_type ≠ model lands on their field, verified or not (status=retired, retired_by=<claim id>). History stays visible.",
      "basis": "HANDOFF T2; decision D6 2026-10-29 (methods M10)"
    }
  ],
